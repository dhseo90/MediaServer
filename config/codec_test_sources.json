{
  "sources": [
    {
      "name": "file_local_h264_aac",
      "source_kind": "file",
      "source": "sample_h264.mp4",
      "enabled": true,
      "requires_network": false,
      "notes": "Local file source for baseline H264/AAC verification.",
      "verify_profile": {
        "label": "local-default",
        "ffprobe_timeout_us": 8000000,
        "webrtc_http_timeout_s": 15
      }
    },
    {
      "name": "file_local_h265_aac",
      "source_kind": "file",
      "source": "sample_h265.mp4",
      "enabled": true,
      "requires_network": false,
      "notes": "Local file source for H265 ingress verification.",
      "verify_profile": {
        "label": "local-default",
        "ffprobe_timeout_us": 8000000,
        "webrtc_http_timeout_s": 15
      }
    },
    {
      "name": "http_local_h264_aac",
      "source_kind": "http",
      "source": "http://127.0.0.1:8765/sample_h264.mp4",
      "enabled": true,
      "requires_network": false,
      "notes": "Local HTTP MP4 source used to verify the URI source path before YouTube/HLS resolver work.",
      "verify_profile": {
        "label": "local-http",
        "ffprobe_timeout_us": 10000000,
        "webrtc_http_timeout_s": 20,
        "rtsp_route_keys": ["default", "h264", "opus"]
      },
      "launcher": {
        "type": "local_http",
        "port": 8765,
        "root": "video"
      }
    },
    {
      "name": "http_local_h264_video_only",
      "source_kind": "http",
      "source": "http://127.0.0.1:8765/sample_h264_video_only.mp4",
      "enabled": true,
      "requires_network": false,
      "notes": "Local HTTP MP4 source without audio. Verifies that URI sources do not require source audio; RTSP routes synthesize silent route audio while WebRTC can signal video-only.",
      "verify_profile": {
        "label": "local-http-video-only",
        "ffprobe_timeout_us": 10000000,
        "webrtc_http_timeout_s": 20,
        "rtsp_routes": [
          {"route_key": "default", "expect_video": "h264", "expect_audio": "aac"},
          {"route_key": "h264", "expect_video": "h264", "expect_audio": "aac"},
          {"route_key": "h265", "expect_video": "hevc", "expect_audio": "aac"}
        ]
      },
      "launcher": {
        "type": "local_http",
        "port": 8765,
        "root": "video"
      }
    },
    {
      "name": "hls_local_h264_aac",
      "source_kind": "hls",
      "source": "http://127.0.0.1:8766/index.m3u8",
      "enabled": true,
      "requires_network": false,
      "notes": "Local HLS VOD generated from sample_h264.mp4. Verifies source=hls without external network dependency.",
      "verify_profile": {
        "label": "local-hls",
        "ffprobe_timeout_us": 15000000,
        "webrtc_http_timeout_s": 25,
        "rtsp_route_keys": ["default", "h264", "opus"]
      },
      "launcher": {
        "type": "local_hls",
        "port": 8766,
        "input": "video/sample_h264.mp4"
      }
    },
    {
      "name": "youtube_upload_h264_aac",
      "source_kind": "youtube",
      "source": "https://www.youtube.com/watch?v=aqz-KE-bpKQ",
      "enabled": false,
      "requires_network": true,
      "notes": "Experimental YouTube uploaded/VOD source. Excluded by default; requires an opt-in YouTube build, yt-dlp, external network access, and explicit runtime opt-in.",
      "verify_profile": {
        "label": "external-youtube-upload",
        "ffprobe_timeout_us": 30000000,
        "webrtc_http_timeout_s": 45,
        "rtsp_route_keys": ["default", "h264", "opus"],
        "server_env_hint": "MEDIA_SERVER_ENABLE_YOUTUBE_SOURCE=1 MEDIA_SERVER_ENABLE_EXPERIMENTAL_YOUTUBE_SOURCE=1 MEDIA_SERVER_YOUTUBE_RESOLVE_TIMEOUT_MS=30000 MEDIA_SERVER_RTSP_SOURCE_START_TIMEOUT_MS=20000 MEDIA_SERVER_RTSP_TRACK_SETTLE_MAX_MS=12000"
      }
    },
    {
      "name": "youtube_live_h264_aac",
      "source_kind": "youtube",
      "source": "https://www.youtube.com/watch?v=iYmvCUonukw",
      "enabled": false,
      "requires_network": true,
      "notes": "Experimental YouTube live/HLS source. Excluded by default; requires an opt-in YouTube build, yt-dlp, external network access, and explicit runtime opt-in.",
      "verify_profile": {
        "label": "external-youtube-live",
        "ffprobe_timeout_us": 30000000,
        "webrtc_http_timeout_s": 45,
        "rtsp_route_keys": ["default", "h264", "opus"],
        "server_env_hint": "MEDIA_SERVER_ENABLE_YOUTUBE_SOURCE=1 MEDIA_SERVER_ENABLE_EXPERIMENTAL_YOUTUBE_SOURCE=1 MEDIA_SERVER_YOUTUBE_RESOLVE_TIMEOUT_MS=30000 MEDIA_SERVER_RTSP_SOURCE_START_TIMEOUT_MS=25000 MEDIA_SERVER_RTSP_TRACK_SETTLE_MAX_MS=15000"
      }
    },
    {
      "name": "rtsp_local_h265_opus",
      "source_kind": "rtsp",
      "source": "rtsp://127.0.0.1:8654/opus",
      "enabled": true,
      "requires_network": false,
      "notes": "Local RTSP source generated from sample_h265.mp4 with Opus audio.",
      "verify_profile": {
        "label": "local-rtsp",
        "rtsp_preflight_timeout_ms": 1500,
        "ffprobe_timeout_us": 8000000,
        "webrtc_http_timeout_s": 15
      },
      "launcher": {
        "type": "local_rtsp",
        "port": 8654,
        "mount": "/opus",
        "input": "video/sample_h265.mp4",
        "video_codec": "h265",
        "audio_codec": "opus"
      }
    },
