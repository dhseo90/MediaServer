# Development preset: local UI/API work, explicit auth-off compatibility.
MEDIA_SERVER_AUTH_MODE=off
MEDIA_SERVER_UI_DEFAULT_HOME=ops
MEDIA_SERVER_LISTEN_ADDRESS=127.0.0.1
MEDIA_SERVER_HTTP_LISTEN_ADDRESS=127.0.0.1
MEDIA_SERVER_LISTEN_PORT=8554
MEDIA_SERVER_HTTP_LISTEN_PORT=8080
MEDIA_SERVER_SOURCE_REGISTRY=.media_server.sources.json
MEDIA_SERVER_PUBLISHED_VIEWS=.media_server.views.json
MEDIA_SERVER_ANALYSIS_REGISTRY=.media_server.analysis_registry.json
MEDIA_SERVER_WEBRTC_ICE_TRANSPORT_POLICY=all
