# Production preset: session auth, secure cookie, relay-preferred external WebRTC.
MEDIA_SERVER_AUTH_MODE=auto
MEDIA_SERVER_AUTH_USERS_FILE=/var/lib/media-server/auth.users.json
MEDIA_SERVER_AUTH_COOKIE_SECURE=1
MEDIA_SERVER_UI_DEFAULT_HOME=ops
MEDIA_SERVER_LISTEN_ADDRESS=0.0.0.0
MEDIA_SERVER_HTTP_LISTEN_ADDRESS=0.0.0.0
MEDIA_SERVER_LISTEN_PORT=8554
MEDIA_SERVER_HTTP_LISTEN_PORT=8080
MEDIA_SERVER_SOURCE_REGISTRY=/var/lib/media-server/sources.json
MEDIA_SERVER_PUBLISHED_VIEWS=/var/lib/media-server/views.json
MEDIA_SERVER_ANALYSIS_REGISTRY=/var/lib/media-server/analysis_registry.json
MEDIA_SERVER_WEBRTC_TURN_SERVER=turn://user:password@example.invalid:3478
MEDIA_SERVER_WEBRTC_ICE_TRANSPORT_POLICY=relay
MEDIA_SERVER_ANALYSIS_EVENT_STORAGE_PATH=/var/lib/media-server/events/event_records.jsonl
