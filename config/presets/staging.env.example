# Staging preset: session auth, local registries, non-relay ICE while validating network paths.
MEDIA_SERVER_AUTH_MODE=auto
MEDIA_SERVER_AUTH_USERS_FILE=.media_server.staging.users.json
MEDIA_SERVER_UI_DEFAULT_HOME=ops
MEDIA_SERVER_LISTEN_ADDRESS=0.0.0.0
MEDIA_SERVER_HTTP_LISTEN_ADDRESS=0.0.0.0
MEDIA_SERVER_LISTEN_PORT=8554
MEDIA_SERVER_HTTP_LISTEN_PORT=8080
MEDIA_SERVER_SOURCE_REGISTRY=.media_server.staging.sources.json
MEDIA_SERVER_PUBLISHED_VIEWS=.media_server.staging.views.json
MEDIA_SERVER_ANALYSIS_REGISTRY=.media_server.staging.analysis_registry.json
MEDIA_SERVER_WEBRTC_STUN_SERVER=stun://stun.l.google.com:19302
MEDIA_SERVER_WEBRTC_ICE_TRANSPORT_POLICY=all
