{
  "schema": "media-server.public-repo-policy.v1",
  "maxTrackedFileBytes": 26214400,
  "deniedTrackedPathPatterns": [
    "^models/",
    "^third_party/",
    "^\\.media_server",
    "^scripts/\\.media_server\\.env$",
    "^.*\\.(gguf|ggml|safetensors|ckpt)$",
    "^video/imports/(?!va_tracking_event_(?:long_)?1280x720_30fps_h264\\.mp4$).+",
    "^.*\\.DS_Store$"
  ],
  "allowedTrackedAssetPatterns": [
    "^video/sample(_h264|_h265|_h264_video_only)?\\.mp4$",
    "^video/va_four_scene_sample\\.mp4$",
    "^video/va_sports_sample\\.mp4$",
    "^video/imports/va_tracking_event_1280x720_30fps_h264\\.mp4$",
    "^video/imports/va_tracking_event_long_1280x720_30fps_h264\\.mp4$",
    "^docs/assets/.+\\.(png|jpg|jpeg)$",
    "^docs/release-artifacts/v[0-9]+\\.[0-9]+\\.[0-9]+/ui-fulltest-[0-9]{8}/in-app-screenshots/.+\\.png$",
    "^docs/release-artifacts/v[0-9]+\\.[0-9]+\\.[0-9]+/ui-fulltest-[0-9]{8}/in-app-final-screenshots/.+\\.png$",
    "^docs/release-artifacts/v3\\.9\\.0/(?:test-acceptance-final|test-acceptance-post-ui-final|ui-automation-case-completeness-final|ui-automation-native-final|ui-automation-playwright-final|ui-automation-visible-dom-final|ui-native-adapter-final)/.+\\.png$",
    "^docs/release-artifacts/v3\\.9\\.0/test-acceptance-failure-20260813-efb44bd1/.+\\.png$",
    "^test/fixtures/.+\\.(json|csv)$"
  ],
  "requiredDocs": [
    "README.md",
    "README.en.md",
    "VERSION",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "DEPENDENCY_SNAPSHOT.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "docs/distribution-policy.md",
    "docs/release-policy.md",
    "docs/versioning-policy.md",
    "docs/public-repo-final-review.md",
    "docs/sample-fixture-provenance.md",
    "docs/en/README.md"
  ],
  "secretPatterns": [
    {
      "id": "github-token",
      "pattern": "gh[pousr]_[A-Za-z0-9_]{20,}"
    },
    {
      "id": "aws-access-key",
      "pattern": "AKIA[0-9A-Z]{16}"
    },
    {
      "id": "google-api-key",
      "pattern": "AIza[0-9A-Za-z_-]{30,}"
    },
    {
      "id": "slack-token",
      "pattern": "xox[baprs]-[A-Za-z0-9-]{20,}"
    },
    {
      "id": "private-key",
      "pattern": "-----BEGIN (RSA|DSA|EC|OPENSSH|PRIVATE) PRIVATE KEY-----"
    }
  ],
  "assetPolicySummary": [
    "Tracked video files are generated smoke fixtures, not production evidence or customer media.",
    "YOLO/VLM model binaries and optional layout models stay ignored under models/ and are fetched or prepared locally.",
    "Large imported media, local auth stores, logs, raw operational evidence media, third_party runtimes, and package-manager binaries are not public repo content.",
    "Release UI screenshots are tracked only under sanitized in-app evidence paths or the exact v3.9.0 audit-only historical roots retained by evidence contracts."
  ]
}
