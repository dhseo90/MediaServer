# 파일 용도: 서버 실행 스크립트가 읽는 로컬 환경변수 예시 파일이다.
#
# Environment overrides loaded by scripts/start_server.sh when present.
# Copy to scripts/.media_server.env and keep only needed lines.
#
# Media bind policy
# - In restricted environments (no UDP), set to 1 to force RTSP over TCP.
MEDIA_SERVER_FORCE_RTSP_TCP=1

# In some Linux/CI/container environments, the server process cannot bind any
# sockets at startup and will fail before request handling.
# Keep this disabled by default and use only when needed.
# If both UDP and TCP bind checks fail in diagnostics, the environment is blocked
# and local runtime validation should be done outside that sandbox.

# If needed, force gstreamer attach context used by server
#MEDIA_SERVER_GST_ATTACH_CONTEXT=default

# Enable verbose SessionManager lifecycle tracing when debugging stream reuse.
#MEDIA_SERVER_SESSION_TRACE=1

# Enable WebRTC negotiation/state tracing. Add *_VERBOSE only when sample,
# pad, caps, and SDP detail logs are needed.
#MEDIA_SERVER_WEBRTC_TRACE=1
#MEDIA_SERVER_WEBRTC_TRACE_VERBOSE=1

# External RTSP source diagnostics and startup tuning
# - Preflight checks host:port reachability before starting RTSP ingress.
# - Start timeout waits for first sample after RTSP source startup.
# - Track settle values control how long we wait for both audio/video tracks.
#MEDIA_SERVER_RTSP_SOURCE_PREFLIGHT_TIMEOUT_MS=1500
#MEDIA_SERVER_RTSP_SOURCE_START_TIMEOUT_MS=3000
#MEDIA_SERVER_RTSP_TRACK_SETTLE_QUIET_PERIOD_MS=1500
#MEDIA_SERVER_RTSP_TRACK_SETTLE_MAX_MS=4000

# macOS default is detached because launchctl can apply a different runtime context.
# Set to launchctl only when you explicitly want a LaunchAgent.
#MEDIA_SERVER_START_MODE=detached

# Auto-start scan defaults (override as needed)
#MEDIA_SERVER_PORT_CANDIDATES=8554,8555,8556
#MEDIA_SERVER_LISTEN_ADDRESS_CANDIDATES=127.0.0.1,0.0.0.0
#MEDIA_SERVER_SKIP_ENV_CHECK=0

# If Homebrew GStreamer is installed in a non-default prefix, override it here.
#HOMEBREW_PREFIX=/opt/homebrew
