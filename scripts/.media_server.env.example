# 파일 용도: ./server.sh가 읽는 로컬 실행 환경 예시 파일이다.
# 사용법: 필요한 경우 이 파일을 scripts/.media_server.env로 복사해서 로컬 값만 수정한다.
# scripts/.media_server.env는 gitignore 대상이다.

# macOS/Homebrew GStreamer: 기본 headless는 GTK3/GTK4/gst-python/GTK validate만 검색에서 제외한다.
# 원본 Homebrew 패키지는 삭제하지 않으며 Linux의 GStreamer 환경은 변경하지 않는다.
# build/start/foreground/test는 로컬 설정 뒤 적용한다. 녹화 focused verify는 로컬 설정을
# 자동으로 읽지 않으므로 필요하면 호출한 셸에서 같은 변수를 명시한다.
#MEDIA_SERVER_GST_PLUGIN_PROFILE=headless
# 전체 설치 플러그인 진단 시 새 셸에서 system을 지정한다(기존 GTK/GI 경고가 다시 나올 수 있음).
#MEDIA_SERVER_GST_PLUGIN_PROFILE=system
# 기본 캐시: 프로젝트의 .media_server.gstreamer. 설치 파일 변경 시 새 캐시를 생성한다.
# 캐시 상위 경로는 존재해야 하며 캐시 자체는 사용자 소유/쓰기 비공유/비링크 디렉터리여야 한다.
# 이전 캐시는 자동 삭제하지 않는다. 검사 중에는 전용 임시 캐시를 사용한다.
#MEDIA_SERVER_GST_CACHE_DIR=/absolute/private/cache-directory
# 추가 플러그인은 GST_PLUGIN_PATH_1_0에 root별 콜론 목록으로 지정한다(.so/.dylib 지원).
# 하위 symlink 디렉터리는 순환 방지로 따라가지 않으므로 해당 실경로를 root 목록에 직접 추가한다.
# 명시한 GST_REGISTRY_1_0/GST_REGISTRY는 유지하며, 미지정 시 위 전용 캐시의 registry를 사용한다.

# 기본 실행 정책
# - install/start 기본값은 AI 포함 빌드이다.
# - RTSP/HTTP는 같은 LAN의 다른 PC에서 접근할 수 있도록 0.0.0.0에 바인딩한다.
MEDIA_SERVER_ENABLE_AI=1
MEDIA_SERVER_BUILD_DIR=build-gst-onnx
MEDIA_SERVER_LISTEN_ADDRESS=0.0.0.0
MEDIA_SERVER_HTTP_LISTEN_ADDRESS=0.0.0.0
MEDIA_SERVER_PORT_CANDIDATES=8554,8555,8556
MEDIA_SERVER_FORCE_RTSP_TCP=1

# 포트를 고정하고 싶을 때만 사용한다. 미지정이면 PORT_CANDIDATES에서 사용 가능한 RTSP 포트를 고른다.
#MEDIA_SERVER_LISTEN_PORT=8554
#MEDIA_SERVER_HTTP_LISTEN_PORT=8080

# AI/YOLO 기본 자산
# ./server.sh install이 기본 모델/라벨을 준비한다.
MEDIA_SERVER_ANALYSIS_MODEL=models/yolo11n.onnx
MEDIA_SERVER_ANALYSIS_LABELS=models/coco.names
# 프로젝트 안의 파일은 상대경로를 권장한다. 아래 값은 시스템 설치 prefix라서 예외적으로 절대경로를 쓴다.
#MEDIA_SERVER_ONNXRUNTIME_ROOT=/opt/homebrew/opt/onnxruntime

# 이벤트 POST는 외부 전송이므로 기본 OFF다. 룰에서 POST URL을 쓰려면 명시적으로 켠다.
MEDIA_SERVER_ANALYSIS_EVENT_POST_ENABLED=0
#MEDIA_SERVER_ANALYSIS_EVENT_POST_COOLDOWN_MS=500

# 디버깅 옵션
#MEDIA_SERVER_SESSION_TRACE=1
#MEDIA_SERVER_WEBRTC_TRACE=1
#MEDIA_SERVER_WEBRTC_TRACE_VERBOSE=1
#MEDIA_SERVER_SKIP_BUILD=1
#MEDIA_SERVER_SKIP_ENV_CHECK=1

# WebRTC/URI 인코딩 품질 및 지연 튜닝
#MEDIA_SERVER_WEBRTC_VIDEO_WIDTH=1280
#MEDIA_SERVER_WEBRTC_VIDEO_HEIGHT=720
#MEDIA_SERVER_WEBRTC_VIDEO_FPS=30
#MEDIA_SERVER_WEBRTC_VIDEO_BITRATE_KBPS=6000
#MEDIA_SERVER_WEBRTC_VIDEO_KEYFRAME_INTERVAL=30
#MEDIA_SERVER_WEBRTC_X264_PRESET=superfast
#MEDIA_SERVER_URI_VIDEO_WIDTH=1280
#MEDIA_SERVER_URI_VIDEO_HEIGHT=720
#MEDIA_SERVER_URI_VIDEO_FPS=30
#MEDIA_SERVER_URI_VIDEO_BITRATE_KBPS=6000
#MEDIA_SERVER_URI_X264_PRESET=superfast

# 외부 RTSP source 진단 및 시작 대기 튜닝
# 신뢰 가능한 카메라/테스트 RTSP URL이 있으면 아래 값으로 지정한다.
# 지정한 URL은 ./server.sh test에서 hard gate로 처리된다.
#MEDIA_SERVER_TEST_EXTERNAL_RTSP_URLS=rtsp://camera-or-test-host/live
#MEDIA_SERVER_RTSP_SOURCE_PREFLIGHT_TIMEOUT_MS=1500
#MEDIA_SERVER_RTSP_SOURCE_START_TIMEOUT_MS=3000
#MEDIA_SERVER_RTSP_TRACK_SETTLE_QUIET_PERIOD_MS=1500
#MEDIA_SERVER_RTSP_TRACK_SETTLE_MAX_MS=4000

# Codex/sandbox처럼 parent process 종료 시 background child가 정리되는 환경이면 foreground를 사용한다.
# 일반 터미널에서는 start가 nohup 기반 detached 실행을 사용한다.
#MEDIA_SERVER_START_STABILITY_WAIT_S=1

# 실험실: YouTube 직접 source 표출은 정책/품질/지연 이슈가 있어 기본 OFF다.
# YouTube 파일 다운로드 import UI는 별도 개발용 기능으로 남긴다.
#MEDIA_SERVER_ENABLE_EXPERIMENTAL_YOUTUBE_SOURCE=1
#MEDIA_SERVER_YOUTUBE_RESOLVER_BIN=yt-dlp
#MEDIA_SERVER_YOUTUBE_RESOLVE_TIMEOUT_MS=15000
#MEDIA_SERVER_YOUTUBE_RECONNECT_DELAY_MS=2000
