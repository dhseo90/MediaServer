{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "media-server.va.runtime-metadata.v1",
  "title": "MediaServer VA Runtime Metadata Side-Channel Payload",
  "type": "object",
  "required": [
    "schema",
    "streamId",
    "channelId",
    "profileKey",
    "frameId",
    "pts",
    "timestampMs",
    "tracks",
    "events"
  ],
  "properties": {
    "schema": {
      "const": "media-server.va.runtime-metadata.v1"
    },
    "streamId": {
      "type": "string"
    },
    "channelId": {
      "type": "string"
    },
    "profileKey": {
      "type": "string"
    },
    "frameId": {
      "type": "integer"
    },
    "pts": {
      "type": "integer"
    },
    "timestampMs": {
      "type": "integer"
    },
    "videoFramePtsMs": {
      "type": "integer"
    },
    "analysisPtsMs": {
      "type": "integer"
    },
    "syncDeltaMs": {
      "type": "integer"
    },
    "syncStatus": {
      "type": "string"
    },
    "syncToleranceMs": {
      "type": "integer"
    },
    "metadataSequence": {
      "type": "integer"
    },
    "sentAtMs": {
      "type": "integer"
    },
    "frameWidth": {
      "type": "integer"
    },
    "frameHeight": {
      "type": "integer"
    },
    "coordinateSpace": {
      "const": "normalized-frame"
    },
    "source": {
      "type": "object",
      "required": [
        "key",
        "sourceKind",
        "route",
        "clientId",
        "vaRuleId",
        "profileKey"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "sourceKind": {
          "type": "string"
        },
        "route": {
          "type": "string"
        },
        "clientId": {
          "type": "string"
        },
        "vaRuleId": {
          "type": "string"
        },
        "profileKey": {
          "type": "string"
        }
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/runtimeTrack"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/runtimeEvent"
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "trackId",
          "scenarioName",
          "scenarioPhase",
          "zoneId",
          "lineId",
          "dwellTimeMs",
          "active"
        ],
        "properties": {
          "trackId": {
            "type": "integer"
          },
          "scenarioName": {
            "type": "string"
          },
          "scenarioPhase": {
            "type": "string"
          },
          "zoneId": {
            "type": "string"
          },
          "lineId": {
            "type": "string"
          },
          "dwellTimeMs": {
            "type": "integer"
          },
          "active": {
            "type": "boolean"
          }
        }
      }
    },
    "metrics": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "timestampMs": {
          "type": "integer"
        },
        "channelCount": {
          "type": "integer"
        },
        "totalTrackCount": {
          "type": "integer"
        },
        "activeTrackCount": {
          "type": "integer"
        },
        "lostTrackCount": {
          "type": "integer"
        },
        "reacquiredTrackCount": {
          "type": "integer"
        },
        "terminatedTrackCount": {
          "type": "integer"
        },
        "activeScenarioCount": {
          "type": "integer"
        },
        "activeEventStateCount": {
          "type": "integer"
        },
        "eventEmittedCount": {
          "type": "integer"
        },
        "eventDedupCount": {
          "type": "integer"
        },
        "trackHealth": {
          "type": "object"
        }
      }
    },
    "trackingIssueReport": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
