{
  "schema": "media-server.manual-ui-fulltest-va-seed-matrix.v1",
  "description": "Throwaway VA seed matrix for v2.3.0 manual UI full test preparation. This is not execution evidence and not production data.",
  "releaseTarget": "v2.3.0",
  "usageBoundary": {
    "authMode": "auto",
    "dataScope": "throwaway",
    "idPolicy": "numeric registry ids only; avoid built-in profile ids 1..5",
    "keepFinalRulesForEventLogReview": true,
    "separateCrudFromScenarioEventReview": true,
    "notEvidenceUntilAppliedAndVerified": true
  },
  "accounts": [
    {
      "role": "admin",
      "username": "ui_admin",
      "purpose": "setup, users, sources, rules, event review, full ops access"
    },
    {
      "role": "operator",
      "username": "ui_operator",
      "purpose": "ops operational access without admin-only account mutation"
    },
    {
      "role": "viewer",
      "username": "ui_viewer",
      "purpose": "client live/dashboard scoped view and ops/lab denial"
    },
    {
      "role": "integrator",
      "username": "ui_integrator",
      "purpose": "API/scope boundary and non-primary UI landing behavior"
    }
  ],
  "sources": [
    {
      "id": "ui-file-sample-h264",
      "kind": "file",
      "file": "sample_h264.mp4",
      "localPath": "video/sample_h264.mp4",
      "purpose": "video playback smoke only, not all VA event proof"
    },
    {
      "id": "ui-file-va-four-scene",
      "kind": "file",
      "file": "va_four_scene_sample.mp4",
      "localPath": "video/va_four_scene_sample.mp4",
      "purpose": "manual VA overlay and visual layout seed; not the default proof for all event/scenario firing"
    },
    {
      "id": "ui-file-va-tracking-event",
      "kind": "file",
      "file": "imports/va_tracking_event_1280x720_30fps_h264.mp4",
      "localPath": "video/imports/va_tracking_event_1280x720_30fps_h264.mp4",
      "purpose": "actual basic VA event firing proof for presence, enter, exit, line-crossing, intrusion-dwell, wrong-direction, intrusion-after-line-crossing, loitering, and zone-occupancy"
    },
    {
      "id": "ui-file-va-tracking-long",
      "kind": "file",
      "file": "imports/va_tracking_event_long_1280x720_30fps_h264.mp4",
      "localPath": "video/imports/va_tracking_event_long_1280x720_30fps_h264.mp4",
      "purpose": "actual re-entry scenario firing proof; same-track exit and re-entry requires a longer fixture"
    },
    {
      "id": "ui-rtsp-loopback",
      "kind": "rtsp",
      "purpose": "30-minute soak candidate when loopback source is prepared"
    },
    {
      "id": "ui-onvif-field-draft",
      "kind": "onvif",
      "purpose": "field-smoke-only draft path; not a default pass requirement"
    }
  ],
