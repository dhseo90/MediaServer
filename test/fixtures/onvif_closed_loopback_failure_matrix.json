{
  "schema": "media-server.onvif-closed-loopback-failure-matrix.v1",
  "description": "Closed loopback ONVIF field probe failures for no-device verification. This is not a product API contract and does not prove real device endpoint success.",
  "defaultExpectedError": "ONVIF probe failed at GetServices: transport error",
  "defaultForbiddenTerms": [
    "127.0.0.1",
    "localhost",
    "\"credentialRef\"",
    "operator-entered-secret",
    "credentialRef=",
    "token=",
    "secret-camera-token",
    "password",
    "Authorization:",
    "Cookie:",
    "rtsp://",
    "rtsps://",
    "raw SOAP"
  ],
  "scenarios": [
    {
      "id": "closed-loopback-device-service",
      "endpoint": "http://127.0.0.1:9/onvif/device_service",
      "timeoutMs": 500,
      "credentialRefPresent": true,
      "expectedStatus": "fail",
      "expectedError": "ONVIF probe failed at GetServices: transport error",
      "expectedConsoleTerms": [
        "ONVIF field HTTP probe sanitized failure",
        "endpoint: configured, redacted",
        "credentialReferencePresent: true",
        "result: fail"
      ],
      "expectedArtifactTerms": [
        "\"schema\": \"media-server.onvif-field-http-probe-result.v1\"",
        "\"status\": \"fail\"",
        "\"credentialReferencePresent\": true",
        "\"endpointRedacted\": true",
        "\"streamUriRedacted\": true",
        "\"rawSoapIncluded\": false"
      ],
      "forbiddenTerms": [
        "/onvif/device_service"
      ]
    },
    {
      "id": "closed-loopback-root-path",
      "endpoint": "http://127.0.0.1:9/",
      "timeoutMs": 500,
      "credentialRefPresent": false,
      "expectedStatus": "fail",
      "expectedError": "ONVIF probe failed at GetServices: transport error",
      "expectedConsoleTerms": [
        "ONVIF field HTTP probe sanitized failure",
        "endpoint: configured, redacted",
        "credentialReferencePresent: false",
        "result: fail"
      ],
      "expectedArtifactTerms": [
        "\"schema\": \"media-server.onvif-field-http-probe-result.v1\"",
        "\"status\": \"fail\"",
        "\"credentialReferencePresent\": false",
        "\"endpointRedacted\": true",
        "\"streamUriRedacted\": true",
        "\"rawSoapIncluded\": false"
      ],
      "forbiddenTerms": []
    },
    {
      "id": "closed-loopback-alt-path",
      "endpoint": "http://127.0.0.1:9/onvif/probe",
      "timeoutMs": 500,
      "credentialRefPresent": true,
      "expectedStatus": "fail",
      "expectedError": "ONVIF probe failed at GetServices: transport error",
      "expectedConsoleTerms": [
        "ONVIF field HTTP probe sanitized failure",
        "endpoint: configured, redacted",
        "credentialReferencePresent: true",
        "result: fail"
      ],
      "expectedArtifactTerms": [
        "\"schema\": \"media-server.onvif-field-http-probe-result.v1\"",
        "\"status\": \"fail\"",
        "\"credentialReferencePresent\": true",
        "\"endpointRedacted\": true",
        "\"streamUriRedacted\": true",
        "\"rawSoapIncluded\": false"
      ],
      "forbiddenTerms": [
        "/onvif/probe"
      ]
    },
    {
      "id": "closed-loopback-query-credential-sentinel",
      "endpoint": "http://127.0.0.1:9/onvif/device_service?profile=main&token=secret-camera-token&credentialRef=operator-entered-secret",
      "timeoutMs": 500,
      "credentialRefPresent": true,
      "expectedStatus": "fail",
      "expectedError": "ONVIF probe failed at GetServices: transport error",
      "expectedConsoleTerms": [
        "ONVIF field HTTP probe sanitized failure",
        "endpoint: configured, redacted",
        "credentialReferencePresent: true",
        "result: fail"
      ],
      "expectedArtifactTerms": [
        "\"schema\": \"media-server.onvif-field-http-probe-result.v1\"",
        "\"status\": \"fail\"",
        "\"credentialReferencePresent\": true",
        "\"endpointRedacted\": true",
        "\"streamUriRedacted\": true",
        "\"rawSoapIncluded\": false"
      ],
      "forbiddenTerms": [
        "/onvif/device_service",
        "profile=main",
        "credentialRef=operator-entered-secret"
      ]
    }
  ]
}
