{
  "schema": "media-server.onvif-unsupported-api-negative-routes.v1",
  "description": "Negative ONVIF route matrix for v1.2.0 no-device verification. This is not a product API contract and does not enable unsupported ONVIF protocols.",
  "routeExerciseMode": "auth-off local server only",
  "allowedRoute": {
    "method": "POST",
    "path": "/ops/api/onvif/import-draft",
    "purpose": "fixture or redacted probe result to SourceRegistry/PublishedView draft only"
  },
  "negativeRoutes": [
    {
      "id": "import-draft-get-method-not-allowed",
      "method": "GET",
      "path": "/ops/api/onvif/import-draft",
      "expectedStatus": 405,
      "expectedBodyTerm": "method not allowed"
    },
    {
      "id": "import-draft-put-method-not-allowed",
      "method": "PUT",
      "path": "/ops/api/onvif/import-draft",
      "expectedStatus": 405,
      "expectedBodyTerm": "method not allowed"
    },
    {
      "id": "ws-discovery-route-not-found",
