        "viewerClientExposureAdded": false,
        "rawPromptStored": false,
        "rawProviderResponseStored": false,
        "credentialStored": false
      }
    },
    {
      "id": "missing-runtime-vlm-only",
      "kind": "missing-runtime",
      "triggerMode": "background",
      "input": {
        "queueState": "not-started",
        "runtimeAvailable": false,
        "operatorOptInAcknowledged": true
      },
      "expected": {
        "status": "blocked",
        "queueAction": "do-not-enqueue",
        "failureReason": "missing-runtime",
        "featureSetStored": false
      },
      "contractInvariants": {
        "runtimeProviderCallPerformed": false,
        "mediaPathBlocked": false,
        "eventRecordBlocked": false,
        "metadataFanoutBlocked": false,
