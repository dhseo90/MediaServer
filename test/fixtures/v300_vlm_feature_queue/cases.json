        "rawPromptStored": false,
        "rawProviderResponseStored": false,
        "credentialStored": false
      }
    },
    {
      "id": "queue-timeout-drop-vlm-only",
      "kind": "queue-timeout",
      "triggerMode": "background",
      "input": {
        "queueState": "full",
        "queueDepth": 4,
        "queueCapacity": 4,
        "queueWaitMs": 5200,
        "queueTimeoutMs": 3000,
        "dropPolicy": "drop-vlm-task"
      },
      "expected": {
        "status": "failed",
        "queueAction": "drop-vlm-task",
        "failureReason": "queue-timeout",
        "featureSetStored": false
