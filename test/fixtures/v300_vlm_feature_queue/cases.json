        "credentialStored": false
      }
    },
    {
      "id": "invalid-output-discarded",
      "kind": "invalid-output",
      "triggerMode": "lazy",
      "input": {
        "queueState": "drained",
        "runtimeAvailable": true,
        "capturedOutputKind": "invalid-json"
      },
      "expected": {
        "status": "failed",
        "queueAction": "discard-invalid-output",
        "failureReason": "invalid-output",
        "featureSetStored": false
