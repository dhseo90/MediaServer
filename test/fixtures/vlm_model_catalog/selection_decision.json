  "excludedRules": [
    {
      "id": "unofficial-or-unknown-license",
      "tier": "T5-excluded-or-blocked",
      "reason": "unofficial mirror, missing model card, or unclear license/provenance"
    },
    {
      "id": "requires-bundled-weight-or-runtime",
      "tier": "T5-excluded-or-blocked",
      "reason": "candidate cannot be used without bundling model weight/runtime into repo or release asset"
    },
    {
      "id": "cloud-without-opt-in",
      "tier": "T5-excluded-or-blocked",
      "reason": "external transfer is required but privacy mode is not cloud-allowed"
    }
