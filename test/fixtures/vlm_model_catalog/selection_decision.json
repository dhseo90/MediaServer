  "conditional": [
    {
      "id": "gemma-family",
      "family": "Gemma",
      "role": "conditional-user-supplied",
      "tier": "T4-conditional-user-supplied",
      "status": "not-default",
      "defaultAllowed": false,
      "requiresLicenseReview": true,
