  "futureModelAdmission": {
    "requiredFields": [
      "officialSourceUrl",
      "licenseUrl",
      "hardGateResults",
      "tier",
      "hardwareClass",
      "minimumRamOrVram",
      "latencyTarget",
      "decisionRole",
      "bundlePolicy",
      "exclusionOrConditionReason"
