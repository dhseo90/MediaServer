{
  "schema": "media-server.vlm-selection-decision.v1",
  "targetStep": "V200-S01",
  "status": "selected",
  "projectLicense": "Apache-2.0",
  "decidedAt": "2026-05-27",
  "decisionScope": "model-selection-criteria-only",
  "nonScope": [
    "pc-capability-detector",
    "recommendation-engine",
    "install-or-connection-ui",
    "profile-storage",
    "runtime-vlm-call",
    "sidecar-storage",
    "event-post-webrtc-sse-ws-schema-change"
  ],
  "hardGates": [
    {
      "id": "G0-official-source",
      "required": true,
      "description": "official model card or provider documentation is required"
    },
    {
      "id": "G0-license-compatible",
      "required": true,
      "description": "license and usage terms must not conflict with the Apache-2.0 source release policy"
    },
    {
      "id": "G0-no-bundle",
      "required": true,
      "description": "model weights, runtime packages, credentials, and download tokens are not included in the repo, release, or bundle"
    },
    {
      "id": "G0-cloud-opt-in",
      "required": true,
      "description": "cloud models require explicit external transfer opt-in"
    },
    {
      "id": "G0-image-input",
      "required": true,
      "description": "candidate must support event image/text evidence interpretation"
    },
    {
      "id": "G0-structured-output-plan",
      "required": true,
      "description": "candidate must be testable for structured output stability in a later harness"
    },
    {
      "id": "G0-no-contract-drift",
      "required": true,
      "description": "Event POST, WebRTC DataChannel, SSE/WS metadata, and media path contracts must not change in this step"
    },
    {
      "id": "G0-viewer-redaction",
      "required": true,
      "description": "viewer/client must not expose prompt, raw response, source URL, credential, or internal model details"
    }
  ],
  "hardwareClasses": {
    "local-unsupported": {
      "planningOnly": true,
      "targetOperatingSystems": [
        "macOS",
        "Linux"
      ],
      "examples": [
        "Intel Mac CPU-only",
        "Apple unified memory below 16GB",
        "GTX 1050 2GB",
        "GTX 1050 3GB",
        "GTX 1050 Ti 4GB",
        "Linux CPU-only",
        "NVIDIA VRAM below 8GB",
        "AMD/Intel GPU runtime not verified",
        "system RAM below 16GB"
      ],
      "defaultLocalVlmAllowed": false,
      "decisionWhenCloudDisabled": "no-local-vlm-recommendation",
      "decisionWhenCloudAllowed": "gemini-2.5-flash",
      "reason": "macOS/Linux local VLM runtime or memory headroom is below the default recommendation floor."
    },
    "local-low": {
      "planningOnly": true,
      "modelClass": "4B class local model",
      "macosCriteria": "Apple Silicon 16GB-23GB unified memory",
      "linuxCriteria": "NVIDIA 8GB-11GB VRAM with 16GB+ system RAM",
      "minimumSystemRamGb": 16,
      "minimumGpuVramGb": 8,
      "minimumAppleUnifiedMemoryGb": 16,
      "memoryGuide": "16GB RAM with 8GB+ VRAM, or 16GB+ Apple unified memory class",
      "allowedTiers": [
        "T2-local-low-spec-fallback"
      ]
    },
    "local-standard": {
      "planningOnly": true,
      "modelClass": "7B/8B class local model",
      "macosCriteria": "Apple Silicon 24GB-47GB unified memory",
      "linuxCriteria": "NVIDIA 12GB-23GB VRAM with 24GB+ system RAM",
      "minimumSystemRamGb": 24,
      "minimumGpuVramGb": 12,
      "minimumAppleUnifiedMemoryGb": 24,
      "memoryGuide": "24GB RAM with 12GB+ VRAM, or 24GB+ Apple unified memory class",
      "allowedTiers": [
        "T1-primary-local-standard"
      ]
    },
    "local-high": {
      "planningOnly": true,
      "modelClass": "30B class local evaluation candidate",
      "macosCriteria": "Apple Silicon 48GB+ unified memory",
      "linuxCriteria": "NVIDIA 24GB+ VRAM with 64GB+ system RAM",
      "minimumSystemRamGb": 64,
      "minimumGpuVramGb": 24,
      "minimumAppleUnifiedMemoryGb": 48,
      "defaultAllowed": false,
      "recommendedCandidate": "Qwen/Qwen3-VL-30B-A3B-Instruct",
      "safeFallback": "Qwen/Qwen3-VL-8B-Instruct",
      "reason": "high tier candidate requires V200-S06 evaluation before default promotion"
    },
    "cloud-allowed": {
      "planningOnly": true,
      "externalTransfer": true,
      "allowedTiers": [
        "T3-cloud-opt-in-fallback"
      ]
    },
    "cloud-disabled": {
      "planningOnly": true,
      "externalTransfer": false,
      "allowedTiers": [
        "T1-primary-local-standard",
        "T2-local-low-spec-fallback"
      ]
    }
  },
  "resourceDecisionPolicy": {
    "planningOnly": true,
    "memoryHeadroomMaxRatio": 0.7,
    "reservedGpuVramGb": 2,
    "latencyTargets": {
      "eventReviewP50Seconds": 10,
      "eventReviewP95Seconds": 30,
      "mustNotBlockMediaPath": true
    },
    "pcSelectionMatrix": [
      {
        "pcClass": "local-unsupported",
        "macosCriteria": "Intel Mac CPU-only, Apple unified memory below 16GB, or VLM runtime not verified",
        "linuxCriteria": "CPU-only, NVIDIA VRAM below 8GB, AMD/Intel GPU runtime not verified, or RAM below 16GB",
        "examples": [
          "GTX 1050/1050 Ti 2GB-4GB",
          "CPU-only",
          "RAM below 16GB"
        ],
        "cloudDisabledDecision": "no-local-vlm-recommendation",
        "cloudAllowedDecision": "gemini-2.5-flash",
        "localModel": null
      },
      {
        "pcClass": "local-low",
        "macosCriteria": "Apple Silicon 16GB-23GB unified memory",
        "linuxCriteria": "NVIDIA 8GB-11GB VRAM with 16GB+ system RAM",
        "examples": [
          "16GB RAM with 8GB+ VRAM",
          "16GB+ Apple unified memory"
        ],
        "cloudDisabledDecision": "Qwen/Qwen3-VL-4B-Instruct",
        "cloudAllowedDecision": "prefer-local-then-gemini-2.5-flash",
        "localModel": "Qwen/Qwen3-VL-4B-Instruct"
      },
      {
        "pcClass": "local-standard",
        "macosCriteria": "Apple Silicon 24GB-47GB unified memory",
        "linuxCriteria": "NVIDIA 12GB-23GB VRAM with 24GB+ system RAM",
        "examples": [
          "24GB RAM with 12GB+ VRAM",
          "24GB+ Apple unified memory"
        ],
        "cloudDisabledDecision": "Qwen/Qwen3-VL-8B-Instruct",
        "cloudAllowedDecision": "prefer-local-then-gemini-2.5-flash",
        "localModel": "Qwen/Qwen3-VL-8B-Instruct"
      },
      {
        "pcClass": "local-high",
        "macosCriteria": "Apple Silicon 48GB+ unified memory",
        "linuxCriteria": "NVIDIA 24GB+ VRAM with 64GB+ system RAM",
        "examples": [
          "48GB+ Apple unified memory",
          "64GB RAM with 24GB+ VRAM"
        ],
        "cloudDisabledDecision": "Qwen/Qwen3-VL-30B-A3B-Instruct evaluation candidate with Qwen/Qwen3-VL-8B-Instruct safe fallback",
        "cloudAllowedDecision": "evaluate-high-local-or-gemini-2.5-flash",
        "localModel": "Qwen/Qwen3-VL-30B-A3B-Instruct",
        "safeFallback": "Qwen/Qwen3-VL-8B-Instruct"
      }
    ]
  },
  "tiers": {
    "T1-primary-local-standard": {
      "defaultRole": "primary-local-standard",
      "requiresExternalTransfer": false,
      "licenseGate": "Apache-2.0 or project-compatible open local license",
      "bundlePolicy": "user-supplied-only"
    },
    "T2-local-low-spec-fallback": {
      "defaultRole": "local-low-spec-fallback",
      "requiresExternalTransfer": false,
      "licenseGate": "Apache-2.0 or project-compatible open local license",
      "bundlePolicy": "user-supplied-only"
    },
    "T1H-local-high-candidate": {
      "defaultRole": "local-high-candidate",
      "requiresExternalTransfer": false,
      "requiresEvaluationBeforeDefault": true,
      "licenseGate": "Apache-2.0 or project-compatible open local license",
      "bundlePolicy": "user-supplied-only"
    },
    "T3-cloud-opt-in-fallback": {
      "defaultRole": "cloud-opt-in-fallback",
      "requiresExternalTransfer": true,
      "privacyModeRequired": "cloud-allowed-explicit-opt-in",
      "bundlePolicy": "no-model-bundle"
    },
    "T4-conditional-user-supplied": {
      "defaultRole": "conditional-user-supplied",
      "defaultAllowed": false,
      "requiresLicenseReview": true
    },
    "T5-excluded-or-blocked": {
      "defaultRole": "excluded",
      "defaultAllowed": false
    }
  },
