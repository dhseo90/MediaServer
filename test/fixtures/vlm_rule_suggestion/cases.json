{
  "schema": "media-server.vlm-rule-suggestion-fixtures.v1",
  "targetStep": "V200-S13",
  "purpose": "Fixture-only VLM rule suggestion candidate matrix. It extracts candidate-only rule drafts from VLMObservation sidecar records and keeps all application as a manual /ops/rules action.",
  "decision": {
    "primarySuggestionCandidate": "sidecar-rule-suggestion-candidate",
    "selectedCandidates": [
      "line-crossing-manual-review",
      "intrusion-dwell-manual-review",
      "zone-occupancy-manual-review"
    ],
    "fallback": "Ops manual review of EventRecord, VLM explanation, and existing /ops/rules rule/template/profile forms",
    "alternatives": [
      "rule-suggestion-review-ui-candidate",
      "provider-rerank-rule-candidate"
    ],
    "excluded": [
      {
        "id": "auto-rule-create-or-apply",
        "reason": "V200-S13 must not write Rule/Profile registry payloads or apply a suggested rule automatically."
      },
      {
        "id": "event-record-top-level-rule-suggestion",
        "reason": "Existing EventRecord/Event POST/WebRTC/SSE/WS contracts must not gain ruleSuggestion fields."
      },
      {
        "id": "client-viewer-rule-suggestion-ui",
        "reason": "Rule suggestions are Ops-only candidates and must not appear in viewer/client surfaces."
      },
      {
        "id": "runtime-vlm-requery-for-rule-suggestion",
        "reason": "S13 uses already stored sidecar observations and must not call local or cloud VLM runtimes."
      }
    ],
    "licenseProvenancePrivacyReview": {
      "modelLicenseReusedFrom": "V200-S01/V200-S05 stored VLM profile metadata",
      "newModelOrProviderAdded": false,
      "rawPromptStored": false,
      "rawResponseStored": false,
      "sourceUrlExposed": false,
      "rawFrameBytesStored": false,
      "credentialMaterialStored": false,
      "externalTransferAdded": false,
      "ruleRegistryWritePerformed": false,
      "operatorDefault": "candidate-only manual save in /ops/rules; no automatic rule/profile application"
    }
  },
